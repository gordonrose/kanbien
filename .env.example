PORT=3000
NODE_ENV=development
ROOT_ADMIN_PUBLIC_ORIGIN=http://localhost:3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=service_platform
DATABASE_USER=service_platform
DATABASE_PASSWORD=change_me_local_only
DATABASE_SSL=false

ROOT_AUTH_BOOTSTRAP_PASSWORD=change_me_local_only
ROOT_AUTH_BOOTSTRAP_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... replace-with-your-local-bootstrap-key
TENANT_AUTH_SESSION_TTL_SECONDS=28800
RESEND_API_KEY=re_replace_with_local_only_key
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
OPENAI_API_KEY=
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-5.2
OPENAI_DAILY_REQUEST_LIMIT=20
OPENAI_MONTHLY_REQUEST_LIMIT=300
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_TRANSCRIPT_MESSAGES=24

REDIS_URL=redis://localhost:6379
ASSETS_LOCAL_STORAGE_ROOT=.local-assets
