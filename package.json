{
  "name": "service-platform",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --import tsx src/scripts/copyFrontendAssets.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "dev": "npm run db:migrate && tsx src/server.ts",
    "dispatcher:jobs": "tsx src/jobDispatcher.ts",
    "scheduler:jobs": "tsx src/jobScheduler.ts",
    "worker:jobs": "tsx src/jobWorker.ts",
    "start": "node dist/scripts/migrate.js && node dist/server.js",
    "start:jobs:dispatcher": "node dist/jobDispatcher.js",
    "start:jobs:scheduler": "node dist/jobScheduler.js",
    "start:jobs:worker": "node dist/jobWorker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:feature-dependencies": "node --import tsx src/scripts/checkFeatureDependencies.ts --write",
    "check:feature-dependencies": "node --import tsx src/scripts/checkFeatureDependencies.ts --check",
    "check:frontend-architecture": "node --import tsx src/scripts/checkFrontendArchitectureDocs.ts",
    "deps:audit": "npm audit --omit=dev",
    "deps:audit:all": "npm audit",
    "codex:tasks": "node --import tsx src/scripts/codexTasks.ts",
    "codex:tasks:write": "node --import tsx src/scripts/codexTasks.ts --write",
    "codex:retire": "node --import tsx src/scripts/codexRetire.ts",
    "codex:task": "node --import tsx src/scripts/codexTask.ts",
    "codex:split": "node --import tsx src/scripts/codexSplit.ts",
    "codex:promote-task": "node --import tsx src/scripts/codexPromoteTask.ts",
    "codex:review-promotion": "node --import tsx src/scripts/codexReviewPromotion.ts",
    "codex:push-reviewed": "node --import tsx src/scripts/codexPushReviewed.ts",
    "git:preflight": "node --import tsx src/scripts/gitPreflight.ts",
    "git:promote": "node --import tsx src/scripts/gitPromote.ts",
    "git:worktree-audit": "node --import tsx src/scripts/gitWorktreeAudit.ts",
    "git:branch-stack-audit": "node --import tsx src/scripts/gitBranchStackAudit.ts",
    "product-discovery:draft": "node --import tsx src/scripts/productDiscoveryDraft.ts",
    "product-discovery:validate": "node --import tsx src/scripts/productDiscoveryValidate.ts",
    "product-discovery:audit-harness": "node --import tsx src/scripts/productDiscoveryHarnessAudit.ts",
    "product-request:validate": "node --import tsx src/scripts/productRequestValidate.ts",
    "technical-steering:validate": "node --import tsx src/scripts/technicalSteeringValidate.ts",
    "story-breakdown:validate": "node --import tsx src/scripts/storyBreakdownValidate.ts",
    "task-breakdown:validate": "node --import tsx src/scripts/taskBreakdownValidate.ts",
    "layer5:task": "node --import tsx src/scripts/layer5/taskRun.ts",
    "layer5:closeout": "node --import tsx src/scripts/layer5/closeout.ts",
    "check:governed-ui-adoption": "node --import tsx src/scripts/checkGovernedUiAdoption.ts",
    "check:governed-root-admin-page-audit": "node --import tsx src/scripts/checkGovernedRootAdminPageAudit.ts",
    "check:governed-root-admin-ui": "node --import tsx src/scripts/checkGovernedRootAdminUi.ts",
    "check:static": "npm run product-request:validate -- --all && npm run check:feature-dependencies && npm run check:governed-ui-adoption && npm run check:governed-root-admin-page-audit && npm run check:governed-root-admin-ui && npm run check:frontend-architecture && npm run typecheck",
    "check:repo": "npm run check:static && npm run deps:audit",
    "test": "node --import tsx src/scripts/runTestSuite.ts",
    "postman:signer": "node docs/postman/helpers/rootAuthSigner.mjs",
    "root-admin:helper": "node src/rootAdminHelper/root-auth-signer-helper.mjs",
    "test:persistence:prepare": "node --import tsx src/scripts/ensureTestDatabase.ts",
    "test:persistence:reset": "node --import tsx src/scripts/resetPostgresTestDatabase.ts",
    "test:persistence": "RUN_POSTGRES_TESTS=true vitest run --fileParallelism false tests/security/rootAuth/persistence.security.test.ts tests/security/platformSecurity/persistence.security.test.ts tests/audit/rootAuth/persistence.audit.test.ts tests/audit/platformSecurity/persistence.audit.test.ts tests/integration/rootAuth/persistence.edge.test.ts tests/integration/rootUsers/persistence.test.ts tests/integration/tenants/persistence.test.ts tests/integration/notificationDelivery/persistence.test.ts tests/integration/jobProcessing/persistence.test.ts tests/integration/tenantAuth/persistence.test.ts tests/integration/tenantConfiguration/persistence.test.ts tests/integration/entityBuilder/persistence.test.ts tests/integration/webAppHierarchyBuilder/persistence.test.ts tests/integration/webAppSurfaceDiscovery/persistence.test.ts tests/integration/assets/persistence.test.ts",
    "test:persistence:preserve": "PRESERVE_POSTGRES_TEST_DATA=true RUN_POSTGRES_TESTS=true vitest run --fileParallelism false tests/security/rootAuth/persistence.security.test.ts tests/security/platformSecurity/persistence.security.test.ts tests/audit/rootAuth/persistence.audit.test.ts tests/audit/platformSecurity/persistence.audit.test.ts tests/integration/rootAuth/persistence.edge.test.ts tests/integration/rootUsers/persistence.test.ts tests/integration/tenants/persistence.test.ts tests/integration/notificationDelivery/persistence.test.ts tests/integration/jobProcessing/persistence.test.ts tests/integration/tenantAuth/persistence.test.ts tests/integration/tenantConfiguration/persistence.test.ts tests/integration/entityBuilder/persistence.test.ts tests/integration/webAppHierarchyBuilder/persistence.test.ts tests/integration/webAppSurfaceDiscovery/persistence.test.ts tests/integration/assets/persistence.test.ts",
    "data:compliance-health": "node --import tsx src/scripts/summarizeDataDictionaryCompliance.ts",
    "test:traceability": "node --import tsx src/scripts/checkTestCaseCoverage.ts",
    "test:coverage-strength": "node --import tsx src/scripts/summarizeTestCoverageStrength.ts",
    "qa:evidence-summary": "node --import tsx src/scripts/summarizeQaEvidence.ts",
    "test:lifecycle:report": "node --import tsx src/scripts/reportTestCaseLifecycle.ts",
    "test:cleanup": "node --import tsx src/scripts/cleanupTestData.ts",
    "test:cleanup:dry": "node --import tsx src/scripts/cleanupTestData.ts --dry-run",
    "test:visual:design-system": "playwright test tests/visual/designSystem/canonicals/navigation/topNav.spec.ts --config=playwright.config.ts",
    "test:visual:design-system:update": "playwright test tests/visual/designSystem/canonicals/navigation/topNav.spec.ts --config=playwright.config.ts --update-snapshots",
    "test:all": "npm run test && npm run test:traceability"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "bullmq": "^5.76.2",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "5.0.1",
    "@types/node": "24.0.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
