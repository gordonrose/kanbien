{
  "name": "service-platform",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --import tsx src/scripts/copyFrontendAssets.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "dev": "npm run db:migrate && tsx src/server.ts",
    "start": "node dist/scripts/migrate.js && node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deps:audit": "npm audit --omit=dev",
    "deps:audit:all": "npm audit",
    "check:static": "npm run typecheck",
    "check:repo": "npm run check:static && npm run deps:audit",
    "test": "node --import tsx src/scripts/runTestSuite.ts",
    "postman:signer": "node docs/postman/rootAuthSigner.mjs",
    "root-admin:helper": "node src/rootAdminHelper/root-auth-signer-helper.mjs",
    "test:persistence:prepare": "node --import tsx src/scripts/ensureTestDatabase.ts",
    "test:persistence:reset": "node --import tsx src/scripts/resetPostgresTestDatabase.ts",
    "test:persistence": "RUN_POSTGRES_TESTS=true vitest run --fileParallelism false tests/security/rootAuth/persistence.security.test.ts tests/security/platformSecurity/persistence.security.test.ts tests/audit/rootAuth/persistence.audit.test.ts tests/audit/platformSecurity/persistence.audit.test.ts tests/integration/rootAuth/persistence.edge.test.ts tests/integration/rootUsers/persistence.test.ts tests/integration/tenants/persistence.test.ts tests/integration/notificationDelivery/persistence.test.ts",
    "test:persistence:preserve": "PRESERVE_POSTGRES_TEST_DATA=true RUN_POSTGRES_TESTS=true vitest run --fileParallelism false tests/security/rootAuth/persistence.security.test.ts tests/security/platformSecurity/persistence.security.test.ts tests/audit/rootAuth/persistence.audit.test.ts tests/audit/platformSecurity/persistence.audit.test.ts tests/integration/rootAuth/persistence.edge.test.ts tests/integration/rootUsers/persistence.test.ts tests/integration/tenants/persistence.test.ts tests/integration/notificationDelivery/persistence.test.ts",
    "test:traceability": "node --import tsx src/scripts/checkTestCaseCoverage.ts",
    "test:lifecycle:report": "node --import tsx src/scripts/reportTestCaseLifecycle.ts",
    "test:cleanup": "node --import tsx src/scripts/cleanupTestData.ts",
    "test:cleanup:dry": "node --import tsx src/scripts/cleanupTestData.ts --dry-run",
    "test:all": "npm run test && npm run test:traceability"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "4.21.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "24.0.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
