NODE_ENV=test

TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5432
TEST_DATABASE_NAME=service_platform_test
TEST_DATABASE_USER=service_platform
TEST_DATABASE_PASSWORD=change_me_local_test_only
TEST_DATABASE_SSL=false

# Optional admin connection for creating the test database.
# If omitted, the script falls back to the TEST_DATABASE_* connection with
# TEST_DATABASE_ADMIN_DB defaulting to postgres.
TEST_DATABASE_ADMIN_HOST=127.0.0.1
TEST_DATABASE_ADMIN_PORT=5432
TEST_DATABASE_ADMIN_DB=postgres
TEST_DATABASE_ADMIN_USER=service_platform
TEST_DATABASE_ADMIN_PASSWORD=change_me_local_test_only
TEST_DATABASE_ADMIN_SSL=false

# Optional test-only bootstrap overrides for persistence-backed rootAuth tests.
TEST_ROOT_AUTH_BOOTSTRAP_PASSWORD=change_me_local_test_only
TEST_ROOT_AUTH_BOOTSTRAP_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... replace-with-a-local-test-key
