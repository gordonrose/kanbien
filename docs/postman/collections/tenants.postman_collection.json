          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bizId\": \"{{removableTenantBizId}}\",\n  \"name\": \"Removable Tenant\",\n  \"category\": \"test\",\n  \"status\": \"draft\"\n}"
        },
        "url": {
