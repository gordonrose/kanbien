{
  "info": {
    "_postman_id": "d3154a2e-1dd3-49c4-bbd2-e29c2a56ca92",
    "name": "Kanbien Tenant Configuration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the tenantConfiguration feature. It includes root-auth bootstrap to obtain a bearer session for exact-tenant root policy reads and updates, plus an optional tenant-session-backed current-tenant policy read."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "rootEmail", "value": "root@example.com" },
    { "key": "rootPassword", "value": "Password123!" },
    { "key": "rootSessionId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "tenantId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "tenantSessionId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "health"]
        }
      }
    },
    {
      "name": "Root Auth - Login Password",
      "description": "Obtains a root bearer session for protected tenantConfiguration routes.",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rootEmail}}\",\n  \"password\": \"{{rootPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-auth/login/password",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "root-auth", "login", "password"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.sessionId) pm.collectionVariables.set(\"rootSessionId\", json.sessionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant Configuration - Get Root Tenant Auth Policy",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{rootSessionId}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/auth-policy",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "tenants", "{{tenantId}}", "auth-policy"]
        }
      }
    },
    {
      "name": "Tenant Configuration - Update Root Tenant Auth Policy",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{rootSessionId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"minLength\": 14,\n  \"minNumbers\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/auth-policy",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "tenants", "{{tenantId}}", "auth-policy"]
        }
      }
    },
    {
      "name": "Tenant Configuration - Get Current Tenant Auth Policy",
      "description": "Optional tenant-side self-read. Requires an already authenticated tenant session with a current tenant selected.",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tenantSessionId}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/tenant/auth-policy",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "tenant", "auth-policy"]
        }
      }
    }
  ]
}
