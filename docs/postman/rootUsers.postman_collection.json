{
  "info": {
    "_postman_id": "8f5ddbc0-c542-4ea7-92c3-84c4c3e63626",
    "name": "Kanbien Root Users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the rootUsers feature mounted at /v1/root-users."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "rootUserId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "email",
      "value": "root.user@example.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create Root User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"firstName\": \"Root\",\n  \"lastName\": \"User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users"
          ]
        }
      }
    },
    {
      "name": "Get Root User By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/{{rootUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "{{rootUserId}}"
          ]
        }
      }
    },
    {
      "name": "Get Root User By Email",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users?email={{email}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users"
          ],
          "query": [
            {
              "key": "email",
              "value": "{{email}}"
            }
          ]
        }
      }
    },
    {
      "name": "List Root Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users?page=1&pageSize=25&orderBy=updatedAt&orderDirection=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "25"
            },
            {
              "key": "orderBy",
              "value": "updatedAt"
            },
            {
              "key": "orderDirection",
              "value": "desc"
            }
          ]
        }
      }
    },
    {
      "name": "List Active Root Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/active?page=1&pageSize=25&orderBy=updatedAt&orderDirection=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "active"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "25"
            },
            {
              "key": "orderBy",
              "value": "updatedAt"
            },
            {
              "key": "orderDirection",
              "value": "desc"
            }
          ]
        }
      }
    },
    {
      "name": "List Deleted Root Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/deleted?page=1&pageSize=25&orderBy=updatedAt&orderDirection=desc&excludeAnonymized=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "deleted"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "25"
            },
            {
              "key": "orderBy",
              "value": "updatedAt"
            },
            {
              "key": "orderDirection",
              "value": "desc"
            },
            {
              "key": "excludeAnonymized",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Update Root User",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"User\",\n  \"status\": \"inactive\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/{{rootUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "{{rootUserId}}"
          ]
        }
      }
    },
    {
      "name": "Soft Delete Root User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/{{rootUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "{{rootUserId}}"
          ]
        }
      }
    },
    {
      "name": "Remove Root User",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/{{rootUserId}}/remove",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "{{rootUserId}}",
            "remove"
          ]
        }
      }
    },
    {
      "name": "Reactivate Root User",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/root-users/{{rootUserId}}/reactivate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-users",
            "{{rootUserId}}",
            "reactivate"
          ]
        }
      }
    }
  ]
}
