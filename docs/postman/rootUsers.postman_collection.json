{
  "info": {
    "_postman_id": "8f5ddbc0-c542-4ea7-92c3-84c4c3e63626",
    "name": "Kanbien Root Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for root-user authentication and the protected rootUsers feature. Public auth routes may now return 429 AUTH_THROTTLED or AUTH_LOCKED_DOWN. Protected routes may return 429 RATE_LIMITED when shared platform security middleware rejects the request."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "rootUserId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "email",
      "value": "elvis.presley@example.com"
    },
    {
      "key": "password",
      "value": "Test1234!"
    },
    {
      "key": "signerUrl",
      "value": "http://127.0.0.1:8787"
    },
    {
      "key": "sessionToken",
      "value": "sess_replace_me"
    },
    {
      "key": "challengeId",
      "value": "chal_replace_me"
    },
    {
      "key": "challengeText",
      "value": "challenge_text_replace_me"
    },
    {
      "key": "publicKeyFingerprint",
      "value": "SHA256:3+JFhM6YBmP0GsrDfni2fMcmFLVqSJQNEXUICGlK+CY"
    },
    {
      "key": "sshSignature",
      "value": "base64_signature_over_challenge_text"
    },
    {
      "key": "keyId",
      "value": "key_replace_me"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Root Auth - Login Password",
      "description": "Stage one of root login. On success it stores challenge variables. Repeated attempts may return 429 AUTH_THROTTLED or AUTH_LOCKED_DOWN.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-auth/login/password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-auth",
            "login",
            "password"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (!json.challengeId) pm.collectionVariables.unset(\"challengeId\");",
              "if (!json.challengeText) pm.collectionVariables.unset(\"challengeText\");",
              "if (json.challengeId) pm.collectionVariables.set(\"challengeId\", json.challengeId);",
              "if (json.challengeText) pm.collectionVariables.set(\"challengeText\", json.challengeText);"
            ]
          }
        }
      ]
    },
    {
      "name": "Root Auth - Sign Challenge",
      "description": "Local helper request that signs the stored challenge text with your configured SSH private key.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challengeText\": \"{{challengeText}}\"\n}"
        },
        "url": {
          "raw": "{{signerUrl}}/sign",
          "host": [
            "{{signerUrl}}"
          ],
          "path": [
            "sign"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.signature) pm.collectionVariables.set(\"sshSignature\", json.signature);",
              "if (json.publicKeyFingerprint) pm.collectionVariables.set(\"publicKeyFingerprint\", json.publicKeyFingerprint);"
            ]
          }
        }
      ]
    },
    {
      "name": "Root Auth - Login SSH",
      "description": "Stage two of root login. On success it stores the bearer session token. Repeated failures may now trigger 429 AUTH_THROTTLED or AUTH_LOCKED_DOWN.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"signature\": \"{{sshSignature}}\",\n  \"publicKeyFingerprint\": \"{{publicKeyFingerprint}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-auth/login/ssh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-auth",
            "login",
            "ssh"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (!json.sessionId) pm.collectionVariables.unset(\"sessionToken\");",
              "if (json.sessionId) pm.collectionVariables.set(\"sessionToken\", json.sessionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Root Auth - Create Principal",
      "description": "Protected root-only credential-management route. This request can now be rejected with 429 RATE_LIMITED by authenticated-sensitive platform security middleware.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rootUserId\": \"{{rootUserId}}\",\n  \"loginEmail\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-auth/principals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-auth",
            "principals"
          ]
        }
      }
    },
    {
      "name": "Root Auth - Change Password",
      "description": "Protected route. This request can now be rejected with 429 RATE_LIMITED by authenticated-sensitive platform security middleware.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"@Nima2or1!Change\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/root-auth/password/change",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "root-auth",
            "password",
            "change"
          ]
        }
      }
    },
